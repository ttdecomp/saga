#!/bin/bash

# force the C numeric locale so %.2f and awk comparisons use '.' as the
# decimal separator regardless of the developer's environment
export LC_NUMERIC=C

# run clang-format on all tracked source files and stage the results
SRC_FILES=$(git ls-files '*.cpp' '*.h' '*.c' '*.hpp' | while read -r f; do [ -f "$f" ] && echo "$f"; done)
if [ -n "$SRC_FILES" ]; then
    echo "$SRC_FILES" | xargs clang-format -i || exit 1
    # shellcheck disable=SC2086
    git add -- $SRC_FILES || exit 1
fi

# build and generate objdiff report
cmake -B build . && cmake --build build || exit 1
cargo build --release --manifest-path gonk/Cargo.toml || exit 1
./gonk/target/release/gonk split || exit 1

# install objdiff-cli if not present
if ! command -v objdiff-cli &> /dev/null; then
    cargo install objdiff-cli --git https://github.com/ttdecomp/objdiff
fi

objdiff-cli report generate -o report.json || exit 1

git add report.json

# regenerate the per-subdirectory matching table in README.md
python3 scripts/matching_report.py --readme || exit 1

# get fuzzy match progress from report
PROGRESS=$(jq ".measures.fuzzy_match_percent" report.json)
PROGRESS=$(printf "%.2f" "$PROGRESS")

# determine badge color
if awk "BEGIN {exit !($PROGRESS >= 90)}"; then
    COLOR="brightgreen"
elif awk "BEGIN {exit !($PROGRESS >= 70)}"; then
    COLOR="green"
elif awk "BEGIN {exit !($PROGRESS >= 50)}"; then
    COLOR="yellow"
elif awk "BEGIN {exit !($PROGRESS >= 30)}"; then
    COLOR="orange"
else
    COLOR="red"
fi

# update badge in README
BADGE_URL="https://img.shields.io/badge/matching-${PROGRESS}%25-${COLOR}"
README_TMP=$(mktemp "${TMPDIR:-/tmp}/saga-readme.XXXXXX") || exit 1
trap 'rm -f "$README_TMP"' EXIT
sed "s|https://img.shields.io/badge/matching-[^)]*|${BADGE_URL}|g" README.md > "$README_TMP" || exit 1
cp "$README_TMP" README.md || exit 1
rm -f "$README_TMP"
trap - EXIT

git add report.json README.md

echo "Progress: ${PROGRESS}%"

# verify no original symbols are missing and extra symbols stay within the
# baseline (needs res/libTTapp.so, checked out locally by the developer)
if [ -f res/libTTapp.so ]; then
    python3 scripts/check_symbols.py || exit 1
else
    echo "WARNING: res/libTTapp.so not present; skipping symbol check"
fi
