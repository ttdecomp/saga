#!/usr/bin/env bash
#MISE description="Configure the WebAssembly host"
#MISE hide=true
set -euo pipefail

args=(-S . -B build-wasm -G Ninja -DBUILD_FOR_HOST=ON -DHOST_ENABLE_ASAN=OFF)
needs_fresh=false
for cache in build-wasm/CMakeCache.txt build-wasm/_deps/*-subbuild/CMakeCache.txt; do
    if [[ -f "$cache" ]] && ! grep -q '^CMAKE_GENERATOR:INTERNAL=Ninja$' "$cache"; then
        needs_fresh=true
    fi
done
if [[ "$needs_fresh" == true ]]; then
    cmake -E remove_directory build-wasm/_deps
    args=(--fresh "${args[@]}")
fi
emcmake cmake "${args[@]}"
