#!/usr/bin/env bash
#MISE description="Configure the matching Android target"
#MISE hide=true
set -euo pipefail

args=(-S . -B build -G Ninja)
if [[ -f build/CMakeCache.txt ]] && ! grep -q '^CMAKE_GENERATOR:INTERNAL=Ninja$' build/CMakeCache.txt; then
    args=(--fresh "${args[@]}")
fi
cmake "${args[@]}"
